{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Traceboard Board",
  "description": "Multi-project design & implementation tracking board. Hierarchy: project > module > feature > interface. Dual-axis status (design/impl), cross-level dependencies, milestones, risks & assets registries (v2), append-only event log.",
  "type": "object",
  "required": ["schemaVersion", "title", "generatedAt", "projects"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date" },
    "source": {
      "type": "object",
      "description": "Provenance of the board.",
      "properties": {
        "repo": { "type": "string" },
        "docsRoot": { "type": "string", "description": "Root for resolving relative doc paths in the viewer." }
      }
    },
    "projects": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/node" } },
    "dependencies": { "type": "array", "items": { "$ref": "#/definitions/dependency" } },
    "milestones": { "type": "array", "items": { "$ref": "#/definitions/milestone" } },
    "risks": { "type": "array", "description": "v2 风险台账：进度/资源/关键问题/质量四类，存量+流量由 risk 事件流推导。", "items": { "$ref": "#/definitions/risk" } },
    "assets": { "type": "array", "description": "v2 资产台账：可积累产出（流程/工具/经验/模板/数据），收益仅在 adopted 后计入。", "items": { "$ref": "#/definitions/asset" } },
    "backlog": {
      "type": "array",
      "description": "未承诺想法：与板上承诺严格分离。uncommitted=仅记录，planned=已纳入计划，cancelled=已放弃（保留以便追溯）。",
      "items": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["uncommitted", "planned", "cancelled"] },
          "node": { "type": "string", "description": "可选：想法关联的节点 id。" },
          "note": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "events": { "type": "array", "items": { "$ref": "#/definitions/event" } },
    "meta": { "type": "object" }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["project", "module", "feature", "interface"] },
        "summary": { "type": "string" },
        "owner": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "design": {
          "type": "object",
          "properties": {
            "status": { "enum": ["draft", "reviewed", "approved", "deprecated"] },
            "docs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": { "type": "string", "description": "Relative path of the design doc, resolvable from the board file location." },
                  "label": { "type": "string" },
                  "anchor": { "type": "string", "description": "Optional #heading anchor inside the doc." }
                }
              }
            },
            "note": { "type": "string" }
          }
        },
        "impl": {
          "type": "object",
          "properties": {
            "status": { "enum": ["todo", "wip", "done", "verified", "na"] },
            "code": { "type": "array", "items": { "type": "string" } },
            "tests": { "type": "array", "items": { "type": "string" } },
            "evidence": { "type": "string", "description": "PR/commit/issue reference proving implementation state." },
            "note": { "type": "string" }
          }
        },
        "estimateHours": { "type": "number", "description": "v2 叶子任务估算工时（两周规则刻度，小时）。" },
        "progressOverride": { "type": "number", "description": "达成度人工修正（0..100）。生效值被推导值 ±20pp 限幅，修正动作走事件流审计。", "maximum": 100, "minimum": 0 },
        "goal": {
          "type": "object",
          "description": "v2 目标契约：完整契约只挂项目目标与一级任务（仪式随粒度衰减）。",
          "properties": {
            "metric": { "type": "string", "description": "量化指标。" },
            "gate": { "type": "string", "description": "门禁阈值/准入标准。" },
            "due": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "契约期限。" },
            "fteBudget": { "type": "number", "description": "FTE 预算（人日或小时，与工时系统刻度一致）。" }
          }
        },
        "children": { "type": "array", "items": { "$ref": "#/definitions/node" } }
      }
    },
    "dependency": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "kind": { "enum": ["depends", "calls", "imports", "data", "deploy", "uses"], "default": "depends" },
        "note": { "type": "string" }
      }
    },
    "milestone": {
      "type": "object",
      "required": ["id", "node", "name", "date", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "node": { "type": "string", "description": "Node id this milestone belongs to (any level)." },
        "name": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Target date." },
        "status": { "enum": ["planned", "at-risk", "hit", "missed"] },
        "criteria": { "type": "array", "items": { "type": "string" }, "description": "Acceptance criteria / definition of done." },
        "evidence": { "type": "string" }
      }
    },
    "event": {
      "type": "object",
      "description": "Append-only history entry. Never rewrite or delete past events; add a new one.",
      "required": ["date", "type", "note"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "node": { "type": "string", "description": "Node id; for type=risk/asset holds the risk/asset id." },
        "type": { "enum": ["design", "impl", "milestone", "dependency", "note", "risk", "asset", "gate", "fte"] },
        "from": { "type": "string", "description": "Previous status (for design/impl/risk/asset changes)." },
        "to": { "type": "string", "description": "New status." },
        "note": { "type": "string" },
        "ref": { "type": "string", "description": "PR/commit/issue/doc reference." }
      }
    },
    "risk": {
      "type": "object",
      "required": ["id", "title", "category", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "category": { "enum": ["schedule", "resource", "problem", "quality"] },
        "p": { "type": "number", "description": "Probability 0..1." },
        "i": { "type": "number", "description": "Impact (exposure = p×i)." },
        "status": { "enum": ["open", "mitigating", "resolved", "accepted"] },
        "owner": { "type": "string" },
        "node": { "type": "string", "description": "Linked node id." },
        "review": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Next review date." },
        "mitigation": { "type": "string" },
        "note": { "type": "string" },
        "openedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "resolvedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "title", "type", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["process", "tool", "knowledge", "template", "data"] },
        "status": { "enum": ["proposed", "deposited", "adopted", "retired"] },
        "scope": { "type": "string", "description": "复用范围：个人/团队/部门/公司。" },
        "node": { "type": "string" },
        "metric": { "type": "string", "description": "收益指标。" },
        "baseline": { "type": "string", "description": "基线（收益三元组之一，缺一则收益只能标注性）。" },
        "value": { "type": "string", "description": "量化收益值。" },
        "unit": { "type": "string" },
        "evidence": { "type": "string", "description": "收益证据出处。" },
        "reused": { "type": "number", "description": "累计复用次数（asset.adopt 事件累积）。" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
